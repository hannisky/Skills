{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReportInput",
  "type": "object",
  "required": ["period", "transactions"],
  "properties": {
    "period": { "type": "string", "description": "Reporting period key" },
    "transactions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "date", "amount"],
        "properties": {
          "id": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "amount": { "type": "number" },
          "category": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
